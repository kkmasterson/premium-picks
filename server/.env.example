# Copy to server/.env.local and fill in values locally. Never commit that file.
# Backend only: never prefix these names with VITE_.
# Keys are loaded by the server-side API and ingestion workers.
BALLDONTLIE_API_KEY=
THE_ODDS_API_KEY=
THESPORTSDB_API_KEY=123

# Leave database settings blank until the local Supabase project is started.
# Later, configure production values in the backend host's secret settings.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

HOST=127.0.0.1
PORT=8787
ARENA_WEB_ORIGIN=http://localhost:3000

# Odds proof: one US region, 1-6 supported markets, six-hour minimum cooldown.
# Monthly local cap is clamped to at most 450, with 10 provider credits reserved.
ARENA_ODDS_MONTHLY_CAP=100
ARENA_ODDS_MARKETS=h2h,spreads,totals,player_points
# Optional canonical Arena Props event UUID. Blank selects the next verified game.
ARENA_ODDS_EVENT_ID=

